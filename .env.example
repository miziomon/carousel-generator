# URL base dell'API (con slash finale)
VITE_API_BASE_URL=https://your-api.example.com/v1/

# Nessun token statico da configurare qui: il login OTP e la sessione
# (session_token) sono gestiti da @mavida/hub-auth (src/auth.js) — mai in
# una variabile VITE_* compilata nel bundle pubblico.

# ── Magic link (Agent Session) ────────────────────────────────────────────
# Nessuna env var aggiuntiva richiesta per il magic link.
# Il token di accesso arriva nell'URL come fragment hash, generato dall'admin via:
#   POST /access-links/exchange
#
# Formato del link da condividere con l'utente:
#   https://your-app.example.com/#access_token=<TOKEN_GENERATO_DALL_ADMIN>
#
# Il token viene scambiato automaticamente all'apertura del link e rimosso dall'URL
# (hubAuth.adoptSession) e da quel momento è gestito come una sessione OTP:
# stessa persistenza, stessa guardia sul 401, stesso refresh da GET /me.
#
# Documentazione backend: spec-agent-session-integration.md

# -----------------------------------------------------------------------------
# Configurazione Deploy (SSH/rsync) — usate da deploy.sh
# -----------------------------------------------------------------------------
# IMPORTANTE: questi dati sono sensibili. Il file .env è in .gitignore.

# Username per accesso SSH
DEPLOY_USER=your-ssh-username

# Indirizzo IP o hostname del server
DEPLOY_HOST=your-server.example.com

# Path remoto dove caricare i file (senza slash finale)
# Assicurarsi che punti a una cartella dedicata esclusivamente all'app
DEPLOY_PATH=/path/to/public_html

# Porta SSH (default: 22)
DEPLOY_PORT=22

# Password per accesso SSH
DEPLOY_PASSWORD=your-ssh-password

# URL pubblico dell'applicazione (mostrato al termine del deploy)
DEPLOY_URL=https://your-app.example.com
